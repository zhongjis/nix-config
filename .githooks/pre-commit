#!/usr/bin/env bash
# Check formatting of staged Nix files before committing.
set -euo pipefail

staged_nix_files=()
while IFS= read -r -d '' file; do
  case "$file" in
    */hardware-configuration.nix | hardware-configuration.nix)
      continue
      ;;
  esac
  staged_nix_files+=("$file")
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.nix')

if [ "${#staged_nix_files[@]}" -eq 0 ]; then
  exit 0
fi

if command -v alejandra >/dev/null 2>&1; then
  check_cmd=(alejandra --check)
else
  check_cmd=(nix fmt -- --check)
fi

if ! "${check_cmd[@]}" "${staged_nix_files[@]}"; then
  printf '\nFix formatting with: nix fmt --' >&2
  printf ' %q' "${staged_nix_files[@]}" >&2
  printf '\n' >&2
  exit 1
fi
